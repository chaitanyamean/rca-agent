# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pycache
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Virtual environments
.venv/
venv/
ENV/
env/
.env.local
.env.*.local

# Secrets — never commit
.env

# pytest
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# mypy
.mypy_cache/
*.pyi

# ruff
.ruff_cache/

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Docker
*.dockerenv

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
