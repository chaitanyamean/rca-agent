# ============================================================
# RCA Agent — environment variable reference
# Copy this file to .env and fill in values for your environment.
# .env is git-ignored; never commit real secrets.
# ============================================================

# ---------- Application ----------
APP_NAME=rca-agent
APP_VERSION=0.1.0
ENVIRONMENT=development      # development | staging | production
DEBUG=false

# ---------- HTTP server ----------
HOST=0.0.0.0
PORT=8000

# ---------- Logging ----------
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json              # json | text

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=rca_agent
NEO4J_DATABASE=neo4j

# ---------- Vector Memory ----------
VECTOR_SIMILARITY_THRESHOLD=0.15
VECTOR_MAX_RESULTS=10

# ---------- RKE Integration Target ----------
# Set these to investigate the RKE application (github.com/chaitanyamean/rke)
# See docs/rke_integration.md for full setup instructions.
RKE_REPOSITORY_PATH=/absolute/path/to/rke
RKE_LOG_PATH=/absolute/path/to/rke/logs
RKE_TARGET_NAME=rke
RKE_BACKEND_SERVICE_NAME=rke-backend
RKE_GIT_MAX_COMMITS=50
RKE_LOG_MAX_LINES=50000
RKE_INVESTIGATION_WINDOW_HOURS=2

# ---------- Jaeger Trace Provider ----------
# Set JAEGER_BASE_URL to enable trace retrieval during investigations.
# Point this at the Jaeger query HTTP port (default 16686).
# Leave blank to run without trace evidence (investigations still work).
#
# Local development (RKE + Jaeger via Docker Compose):
#   JAEGER_BASE_URL=http://localhost:16686
#
# Docker Compose (rca-agent container on same network as RKE):
#   JAEGER_BASE_URL=http://jaeger:16686
JAEGER_BASE_URL=http://localhost:16686
JAEGER_TIMEOUT_SECONDS=10.0
# Must match OTEL_SERVICE_NAME in the RKE backend (default: rke-backend)
JAEGER_SERVICE_NAME=rke-backend
# How many hours back to search when no explicit time range is given
JAEGER_LOOKBACK_HOURS=2.0

# ---------- LLM Provider (Phase 4 real-LLM evaluation) ----------
# Set LLM_PROVIDER=openai to use a real LLM for Phase 4 evaluation.
# The OpenAI API key is read directly from the environment by
# langchain-openai — NOT stored as a pydantic-settings field.
# Replace the placeholder value in your local .env (never commit it).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2
LLM_RETRY_WAIT_SECONDS=2.0

# OpenAI API key — required when LLM_PROVIDER=openai
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API key — required when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# ---------- Phase 3 — Memory experiment control ----------
# MEMORY_ENABLED=true  → Memory ON (default)
# MEMORY_ENABLED=false → Memory OFF
MEMORY_ENABLED=true

# ---------- Log source ----------
# 'file'   → LocalLogProvider reads NDJSON files from LOG_DIR (default)
# 'docker' → DockerLogProvider reads from a running Docker container
# LOG_SOURCE=docker
# LOG_DOCKER_CONTAINER=rke-backend
# LOG_DOCKER_SINCE_MINUTES=60

# ---------- Autonomous Jaeger Monitor ----------
# Start with: .venv/bin/python scripts/monitor.py
RCA_POLL_INTERVAL_SECONDS=5
RCA_LOOKBACK_SECONDS=30
# Comma-separated service names to monitor. Leave empty to monitor ALL services.
RCA_MONITOR_SERVICES=
# Environment label written on auto-detected incidents.
RCA_MONITOR_ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://rca_agent:rca_agent@localhost:5432/rca_agent
DATABASE_URL_ASYNC=postgresql+asyncpg://rca_agent:rca_agent@localhost:5432/rca_agent
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# ---------- Future: PostgreSQL (not active yet) ----------
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/rca_agent

# ---------- Future: Neo4j (not active yet) ----------
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password
