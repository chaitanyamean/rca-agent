# ============================================================
# RCA Agent — environment variable reference
# Copy this file to .env and fill in values for your environment.
# .env is git-ignored; never commit real secrets.
# ============================================================

# ---------- Application ----------
APP_NAME=rca-agent
APP_VERSION=0.1.0
ENVIRONMENT=development      # development | staging | production
DEBUG=false

# ---------- HTTP server ----------
HOST=0.0.0.0
PORT=8000

# ---------- Logging ----------
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json              # json | text

# ---------- Future: LLM provider (not active yet) ----------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# ---------- Future: PostgreSQL (not active yet) ----------
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rca_agent

# ---------- Future: Neo4j (not active yet) ----------
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password
